{
    "name": "programster/pgsql-objects",
    "type": "library",
    "description": "A PHP ORM built for PostgreSQL, using its features to save and delete many records across tables in one round trip.",
    "keywords": ["orm", "pgsql", "postgresql", "models"],
    "homepage": "https://github.com/programster/package-pgsql-objects",
    "license": "MIT",
    "authors": [
        {
            "name": "Stuart Page",
            "email": "sdpagent@gmail.com",
            "homepage": "https://blog.programster.org",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "programster/pgsql-lib": "^3.0",
        "ramsey/uuid": "^4.7",
        "ext-pgsql": "*"
    },
    "require-dev" : {
        "programster/pgsql-migrations": "^1.1",
        "programster/autoloader": "^1.0.3"
    },
    "autoload": {
        "psr-4": {
            "Programster\\PgsqlObjects\\": "src/",
            "Programster\\PgsqlObjects\\Exceptions\\": "src/exceptions"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-5.x": "5.0.x-dev"
        }
    }
}
