# Keep Unix line endings in the working copy everywhere, including on Windows (e.g. the Windows and WSL test runners),
# where Git would otherwise convert them to CRLF, which stops bash from running the scripts in testing/.
* text=auto eol=lf

# Leave development-only files out of the archives GitHub generates, which are what Composer downloads when the
# package is installed, so installs only get src/, composer.json, the README, the changelog and the licence. They are
# still in the repository, so cloning it, reading the docs and running the tests work as normal.
/docs             export-ignore
/testing          export-ignore
/.github          export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore
