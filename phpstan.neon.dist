# PHPStan settings. Run with: vendor/bin/phpstan
# Level 5 is the highest the code passes. Level 6 and up mostly ask for the value types of the arrays (e.g. rows and
# where pairs) that the public methods take and return, which have yet to be documented.
parameters:
    level: 5
    phpVersion:
        min: 80200
        max: 80599
    paths:
        - src
        - testing
    # testing/settings.php is git-ignored, so it's only there when it's been created to run the tests against a single
    # database. The (?) marks it optional, as PHPStan otherwise refuses to run when an excluded path doesn't exist.
    excludePaths:
        - testing/settings.php (?)
    # The tables' methods query the database, so calling one again can return something different, e.g. the number of
    # rows after some were deleted. Without this, PHPStan assumes a second call returns what the first did.
    rememberPossiblyImpureFunctionValues: false
    ignoreErrors:
        # PHP has no "friend" classes, so AbstractTable reaches a record's protected members, and Transaction reaches
        # a table's private ones, through closures run in the other object's scope (with Closure::call() or
        # Closure::bind()). PHPStan reads each closure's $this as the class it was written in, so it can't find the
        # members, nor see that Transaction is what calls takeOnDeletedObjects(), or what its runStatements() returns.
        -
            identifier: method.notFound
            path: src/AbstractTable.php
            count: 2
        -
            identifier: property.notFound
            path: src/AbstractTable.php
            count: 3
        -
            identifier: method.unused
            path: src/AbstractTable.php
            count: 1
        -
            identifier: method.notFound
            path: src/Transaction.php
            count: 4
        -
            identifier: return.type
            path: src/Transaction.php
            count: 1
        # The same for the tests that reach a table's or a record's protected members, to check them.
        -
            identifier: method.notFound
            path: testing/tests/TestDeleteWhereOr.php
            count: 1
        -
            identifier: property.notFound
            path: testing/tests/TestDottedNames.php
            count: 1
        -
            identifier: method.notFound
            path: testing/tests/TestExceptions.php
            count: 1
        -
            identifier: arguments.count
            path: testing/tests/TestFieldInfoMapCache.php
            count: 1
        # TicketTable's generateId() is declared to always throw, so PHPStan knows it does, but this test checks that
        # it really does.
        -
            identifier: identical.alwaysFalse
            path: testing/tests/TestDatabaseGeneratedId.php
            count: 1
        # The slow test is switched off with a constant, which is only changed by hand to run it.
        -
            identifier: if.alwaysFalse
            path: testing/tests/TestRandomness.php
            count: 1
